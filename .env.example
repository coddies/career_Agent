# career_agent — Environment Variables
# Copy this file to .env and fill in your API keys.
# On HF Spaces: add these in Space Settings > Variables and Secrets.

# Tier 1 — Google Gemini (required)
GEMINI_API_KEY=your_gemini_key_here

# Tier 2 — Groq (required)
GROQ_API_KEY=your_groq_key_here

# Tier 3 — NVIDIA NIM (optional)
NVIDIA_API_KEY=your_nvidia_key_here

# Tier 4 — Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI CORS (optional — defaults to * for dev)
# Set to your Vercel URL in production:
ALLOWED_ORIGINS=https://your-app.vercel.app
