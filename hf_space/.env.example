# career_agent — Environment Variables Template
# Copy to .env and fill in your keys.
# On HF Spaces: set these in Settings > Variables and Secrets (NOT in .env file)

# Tier 1 — Google Gemini (required)
GEMINI_API_KEY=your_gemini_key_here

# Tier 2 — Groq (required)
GROQ_API_KEY=your_groq_key_here

# Tier 3 — NVIDIA NIM (optional)
NVIDIA_API_KEY=your_nvidia_key_here

# Tier 4 — Ollama local (optional)
OLLAMA_BASE_URL=http://localhost:11434
